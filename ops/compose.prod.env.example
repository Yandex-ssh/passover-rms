# Copy to a deployment-only environment file; never commit the real file.
MYSQL_DATABASE=passover
MYSQL_USER=laravel
MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_ROOT_PASSWORD
MYSQL_APP_PASSWORD=REPLACE_WITH_UNIQUE_APP_PASSWORD
TLS_CERTIFICATE_FILE=/absolute/path/to/trusted/fullchain.pem
TLS_PRIVATE_KEY_FILE=/absolute/path/to/private/privkey.pem
