APP_NAME="Pass-over Cafe RMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=REPLACE_WITH_FINAL_SERVER_URL
FRONTEND_URL=REPLACE_WITH_FINAL_SERVER_URL

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=passover
DB_USERNAME=laravel
DB_PASSWORD=REPLACE_WITH_MYSQL_APP_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=REPLACE_WITH_FINAL_SERVER_HOST

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=10
AI_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
